#
# Managed by ansible
#

[Unit]
Description={{ scheduled_script_description }}
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart={{ scheduled_script_file }}
{% if scheduled_script_notification_mail is defined %}
ExecStopPost={{ scheduled_script_notification_script_file }}
{% endif %}

[Install]
WantedBy=multi-user.target
